# Basic hardening for Apache / LiteSpeed (XAMPP and InfinityFree)
Options -Indexes
DirectoryIndex index.php

# Never serve configuration, SQL or Markdown files directly
<FilesMatch "^(config\.php|config\.sample\.php)$|\.(sql|md|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
